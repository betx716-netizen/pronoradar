# ─── Analyses ────────────────────────────────────────────────────────────────
# Clé Google Gemini (https://aistudio.google.com/apikey) — obligatoire hors mode démo
GEMINI_API_KEY=
# Facultatif : impose un modèle précis (par défaut : gemini-flash-latest)
GEMINI_MODEL=
# The Odds API (https://the-odds-api.com) — matchs et cotes des bookmakers
ODDS_API_KEY=
# API-Football (https://dashboard.api-football.com/register) — stats, blessés, pronostics chiffrés
API_FOOTBALL_KEY=
# Secours gratuits, utilisés automatiquement quand les quotas ci-dessus sont épuisés
GROQ_API_KEY=
TAVILY_API_KEY=

# ─── Moteur quotidien ────────────────────────────────────────────────────────
# Secret partagé avec le cron Vercel (une longue chaîne aléatoire). Obligatoire.
CRON_SECRET=
# Adresse publique de l'application, ex. https://pronoradar.vercel.app (sert aux relances et au retour de paiement)
APP_URL=
# Facultatif : championnats suivis chaque jour (noms de lib/leagues.ts séparés par des virgules)
DAILY_LEAGUES=
# Facultatif : nombre maximum de matchs analysés par jour (16 par défaut)
DAILY_MAX_MATCHES=
# Facultatif : analyses menées en parallèle (3 par défaut)
DAILY_CONCURRENCY=
# Facultatif : "rapide" pour économiser les quotas (par défaut : analyse complète)
DAILY_MODE=

# ─── Comptes et abonnements (Supabase) ──────────────────────────────────────
SUPABASE_URL=
# Clé publishable (sb_publishable_…) : utilisée par le navigateur pour la connexion par email
SUPABASE_KEY=
# Clé secrète (sb_secret_… ou service_role) : serveur uniquement, ne jamais la partager
SUPABASE_SECRET_KEY=
# Emails des administrateurs (Premium offert, accès au diagnostic), séparés par des virgules
ADMIN_EMAILS=

# ─── Paiement (CinetPay) ─────────────────────────────────────────────────────
CINETPAY_API_KEY=
CINETPAY_SITE_ID=

# Mettre à 1 pour tester toute l'application avec des données fictives (connexion : code 123456, paiement simulé)
DEMO_MODE=0
