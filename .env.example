# Clé API Anthropic (https://console.anthropic.com) — obligatoire hors mode démo
ANTHROPIC_API_KEY=

# Mettre à 1 pour tester l'interface avec des données fictives, sans clé ni frais
DEMO_MODE=0

# Facultatif : protège l'application par un mot de passe (recommandé si elle est en ligne)
APP_PASSWORD=
