# Clé Google Gemini (https://aistudio.google.com/apikey) — obligatoire hors mode démo
GEMINI_API_KEY=
# Facultatif : impose un modèle précis (par défaut : gemini-flash-latest)
GEMINI_MODEL=

# The Odds API (https://the-odds-api.com) — cotes des bookmakers, facultatif mais recommandé
ODDS_API_KEY=

# API-Football (https://dashboard.api-football.com/register) — stats, blessés, pronostics chiffrés
API_FOOTBALL_KEY=

# Mettre à 1 pour tester l'interface avec des données fictives, sans clé
DEMO_MODE=0

# Facultatif : protège l'application par un mot de passe (recommandé si elle est en ligne)
APP_PASSWORD=
